# =============================================================================
# MedCP configuration — copy to `.env` and fill in. At least ONE database
# (knowledge graph or clinical records) must be configured.
# =============================================================================

# --- Biomedical Knowledge Graph (Neo4j, optional) ---------------------------
# Example: KNOWLEDGE_GRAPH_URI=bolt://localhost:7687
KNOWLEDGE_GRAPH_URI=bolt://spokedev.cgl.ucsf.edu:7687
KNOWLEDGE_GRAPH_USERNAME=
KNOWLEDGE_GRAPH_PASSWORD=
KNOWLEDGE_GRAPH_DATABASE=spoke

# --- Clinical Records / EHR (optional) --------------------------------------
# Choose the SQL engine: mssql (SQL Server), mysql (MySQL/MariaDB), or sqlite.
CLINICAL_RECORDS_BACKEND=mssql

# For mssql / mysql backends:
CLINICAL_RECORDS_SERVER=
CLINICAL_RECORDS_DATABASE=
CLINICAL_RECORDS_USERNAME=
CLINICAL_RECORDS_PASSWORD=
# CLINICAL_RECORDS_PORT=1433        # optional (mssql default 1433, mysql 3306)

# For the sqlite backend (local file), instead set:
# CLINICAL_RECORDS_BACKEND=sqlite
# CLINICAL_RECORDS_SQLITE_PATH=/absolute/path/to/database.sqlite

# --- Optional MedCP settings ------------------------------------------------
MEDCP_NAMESPACE=MedCP
MEDCP_LOG_LEVEL=INFO
