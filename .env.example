# =============================================================================
# MedCP configuration — copy to `.env` and fill in ONLY what you need.
#
# BOTH sections below are OPTIONAL:
#   1) Knowledge graph  — if left blank, MedCP automatically uses the bundled
#                         SPOKE production graph (no credentials required).
#   2) Clinical records — if left blank, MedCP runs as a SPOKE-only query tool
#                         (no electronic-health-record connection at all).
# =============================================================================

# -----------------------------------------------------------------------------
# 1) BIOMEDICAL KNOWLEDGE GRAPH  (Neo4j / compatible)  — OPTIONAL
#
#    Leave ALL four blank to use the bundled SPOKE production graph for free.
#    Fill them in ONLY to point MedCP at your OWN knowledge graph instead.
#    >>> These credentials are for YOUR Neo4j knowledge-graph server. <<<
# -----------------------------------------------------------------------------
# KNOWLEDGE_GRAPH_URI=bolt://your-neo4j-host:7687
# KNOWLEDGE_GRAPH_USERNAME=neo4j
# KNOWLEDGE_GRAPH_PASSWORD=your-neo4j-password
# KNOWLEDGE_GRAPH_DATABASE=neo4j
# MEDCP_DISABLE_KNOWLEDGE_GRAPH=0     # set to 1 to turn the knowledge graph off entirely

# -----------------------------------------------------------------------------
# 2) CLINICAL RECORDS / EHR  — OPTIONAL (omit entirely for a SPOKE-only tool)
#
#    Pick ONE backend and fill in ONLY that backend's settings.
# -----------------------------------------------------------------------------
# CLINICAL_RECORDS_BACKEND=sqlite      # one of: sqlite | mysql | mssql

## --- Backend A: sqlite (local file) — needs ONLY a file path, no credentials
# CLINICAL_RECORDS_BACKEND=sqlite
# CLINICAL_RECORDS_SQLITE_PATH=/absolute/path/to/database.sqlite

## --- Backend B: mysql (MySQL / MariaDB)
##     >>> These credentials are for YOUR MySQL server. <<<
# CLINICAL_RECORDS_BACKEND=mysql
# CLINICAL_RECORDS_SERVER=your-mysql-host
# CLINICAL_RECORDS_DATABASE=omop
# CLINICAL_RECORDS_USERNAME=your-mysql-user
# CLINICAL_RECORDS_PASSWORD=your-mysql-password
# CLINICAL_RECORDS_PORT=3306

## --- Backend C: mssql (Microsoft SQL Server)
##     >>> These credentials are for YOUR SQL Server. <<<
# CLINICAL_RECORDS_BACKEND=mssql
# CLINICAL_RECORDS_SERVER=your-sqlserver-host
# CLINICAL_RECORDS_DATABASE=OMOP_DEID
# CLINICAL_RECORDS_USERNAME=your-sqlserver-user
# CLINICAL_RECORDS_PASSWORD=your-sqlserver-password
# CLINICAL_RECORDS_PORT=1433

# -----------------------------------------------------------------------------
# 3) MedCP options
# -----------------------------------------------------------------------------
MEDCP_NAMESPACE=MedCP
MEDCP_LOG_LEVEL=INFO
