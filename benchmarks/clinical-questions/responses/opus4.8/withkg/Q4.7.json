              "name": "medcp__MedCP-query_clinical_records",
              "arguments": {
                "sql_query": "SELECT concept_id, concept_name, domain_id, vocabulary_id, concept_class_id, standard_concept\nFROM omop.concept\nWHERE domain_id = 'Condition'\n  AND (LOWER(concept_name) LIKE '%difficile%' OR LOWER(concept_name) LIKE '%c. diff%' OR LOWER(concept_name) LIKE '%clostridium difficile%' OR LOWER(concept_name) LIKE '%clostridioides difficile%')\nORDER BY standard_concept DESC, concept_name\nLIMIT 50"
              }
            }
          },
