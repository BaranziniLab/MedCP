              "name": "medcp__MedCP-query_clinical_records",
              "arguments": {
                "sql_query": "SELECT concept_id, concept_name, domain_id, vocabulary_id, concept_class_id, standard_concept\nFROM omop.concept\nWHERE vocabulary_id = 'RxNorm' AND concept_class_id = 'Ingredient'\nAND lower(concept_name) IN ('furosemide','bumetanide','torsemide','ethacrynic acid','torasemide')"
