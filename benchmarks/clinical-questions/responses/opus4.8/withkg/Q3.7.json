          "toolCall": {
            "status": "success",
            "value": {
              "name": "medcp__MedCP-query_clinical_records",
              "arguments": {
                "sql_query": "SELECT concept_id, concept_name, domain_id, vocabulary_id, concept_class_id, standard_concept\nFROM omop.concept\nWHERE lower(concept_name) LIKE '%methotrexate%'\n  AND domain_id = 'Drug' AND standard_concept = 'S' AND concept_class_id = 'Ingredient'"
