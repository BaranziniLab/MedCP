{
  "mcpServers": {
    "medcp": {
      "command": "uvx",
      "args": ["--from", "${MEDCP_SOURCE:-git+https://github.com/BaranziniLab/MedCP@v0.9.0}", "medcp"],
      "env": {
        "CLINICAL_RECORDS_BACKEND": "${CLINICAL_RECORDS_BACKEND:-}",
        "CLINICAL_RECORDS_SQLITE_PATH": "${CLINICAL_RECORDS_SQLITE_PATH:-}",
        "CLINICAL_RECORDS_SERVER": "${CLINICAL_RECORDS_SERVER:-}",
        "CLINICAL_RECORDS_DATABASE": "${CLINICAL_RECORDS_DATABASE:-}",
        "CLINICAL_RECORDS_USERNAME": "${CLINICAL_RECORDS_USERNAME:-}",
        "CLINICAL_RECORDS_PASSWORD": "${CLINICAL_RECORDS_PASSWORD:-}",
        "CLINICAL_RECORDS_PORT": "${CLINICAL_RECORDS_PORT:-}",
        "KNOWLEDGE_GRAPH_URI": "${KNOWLEDGE_GRAPH_URI:-}",
        "KNOWLEDGE_GRAPH_USERNAME": "${KNOWLEDGE_GRAPH_USERNAME:-}",
        "KNOWLEDGE_GRAPH_PASSWORD": "${KNOWLEDGE_GRAPH_PASSWORD:-}",
        "KNOWLEDGE_GRAPH_DATABASE": "${KNOWLEDGE_GRAPH_DATABASE:-}",
        "MEDCP_NAMESPACE": "${MEDCP_NAMESPACE:-MedCP}",
        "MEDCP_LOG_LEVEL": "${MEDCP_LOG_LEVEL:-INFO}"
      }
    }
  }
}
