**/.DS_Store
.venv/
__pycache__/
*.pyc

# Secrets / local credentials (used for local testing, never committed)
.env

# Generated at build time from the shared core (see scripts/build_releases.py)
integrations/biorouter/src/
integrations/biorouter/uv.lock
build/
!landing/build/
!landing/build/**

# Benchmark databases are large; ignore by default and allow-list the ones
# trimmed to fit under GitHub's 100 MB file-size limit.
benchmarks/**/*.sqlite
!benchmarks/sham-dataset/sqlite/sham_mimic_omop.sqlite

# Local AWS test-DB connection details written by the provision scripts
benchmarks/sham-dataset/*/.dbenv
